###  http://example.org/university-admission#ValidGPARequirementIndia
:ValidGPARequirementIndia rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasGPA_Base10 ;
                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:decimal ;
                                                                                     owl:withRestrictions ( [ xsd:minInclusive 7.0
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasGPA_Base100 ;
                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:decimal ;
                                                                                     owl:withRestrictions ( [ xsd:minInclusive 60.0
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasGPA_Base4 ;
                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:decimal ;
                                                                                     owl:withRestrictions ( [ xsd:minInclusive 2.8
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :hasGPA_Base8 ;
                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:decimal ;
                                                                                     owl:withRestrictions ( [ xsd:minInclusive 5.6
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                              ]
                                                            )
                                              ] .


