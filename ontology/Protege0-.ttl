<http://example.org/university-admission> rdf:type owl:Ontology ;
                                           rdfs:comment "Ontologia per la valutazione dei requisiti di ammissione per studenti indiani e iraniani." .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/university-admission#hasAppliedFor
:hasAppliedFor rdf:type owl:ObjectProperty ;
               rdfs:domain :Student ;
               rdfs:range :Course .


###  http://example.org/university-admission#hasQualification
:hasQualification rdf:type owl:ObjectProperty ;
                  rdfs:domain :Student ;
                  rdfs:range :Qualification .


