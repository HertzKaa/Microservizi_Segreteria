###  http://example.org/university-admission#EligibleIranianUndergraduateStudent
:EligibleIranianUndergraduateStudent rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( :IranianStudent
                                                                                [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
