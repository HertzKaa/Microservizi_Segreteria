###  http://example.org/university-admission#EligibleIndianPostgraduateStudent
:EligibleIndianPostgraduateStudent rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( :IndianStudent
                                                                              [ rdf:type owl:Class ;
                                                                                owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                       owl:onProperty :hasQualification ;
                                                                                                                       owl:someValuesFrom :PassGeneralBachelorDegree
                                                                                                                     ]
                                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                                       owl:onProperty :hasQualification ;
                                                                                                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                                            owl:unionOf ( :MasterDegree
                                                                                                                                                          :PostgraduateBachelorDegree
                                                                                                                                                        )
                                                                                                                                          ]
                                                                                                                     ]
                                                                                                                   ) ;
                                                                                                rdf:type owl:Class
                                                                                              ]
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :hasQualification ;
                                                                                                owl:someValuesFrom :ValidHonoursDegree
                                                                                              ]
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :hasQualification ;
                                                                                                owl:someValuesFrom :ValidProfessionalDegree
                                                                                              ]
                                                                                            )
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasAppliedFor ;
                                                                                owl:someValuesFrom :PostgraduateCourse
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty :hasQualification ;
                                                                                owl:someValuesFrom :ValidGPARequirementIndia
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] .


###  http://example.org/university-admission#EligibleIndianUndergraduateStudent
:EligibleIndianUndergraduateStudent rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( :IndianStudent
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasAppliedFor ;
                                                                                 owl:someValuesFrom :UndergraduateCourse
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasQualification ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( :AllIndiaSeniorSchoolCertificate
                                                                                                                    :HigherSecondaryExaminationCertificatePartII
                                                                                                                    :HigherSecondarySchoolCertificate
                                                                                                                    :IndianSchoolCertificate
                                                                                                                    :IntermediateExaminationCertificate
                                                                                                                  )
                                                                                                    ]
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] .


