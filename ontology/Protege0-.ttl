                                                                                                                        owl:onProperty :hasQualification ;
                                                                                                                        owl:someValuesFrom :ValidKarshenasiNapayvasteh2Years
                                                                                                                      ]
                                                                                                                    ) ;
                                                                                                 rdf:type owl:Class
                                                                                               ]
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty :hasQualification ;
                                                                                                 owl:someValuesFrom :ValidKarshenasiDegree
